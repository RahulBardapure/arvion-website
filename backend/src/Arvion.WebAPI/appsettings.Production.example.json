{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "ConnectionStrings": {
    "DefaultConnection": "#{AZURE_SQL_CONNECTION_STRING}#"
  },
  "Cors": {
    "Origins": [ "https://YOUR_SWA_HOSTNAME.azurestaticapps.net" ]
  },
  "Jwt": {
    "Key": "#{JWT_KEY}#",
    "Issuer": "Arvion",
    "Audience": "ArvionAdmin"
  },
  "Email": {
    "Enabled": true,
    "Provider": "Smtp",
    "FromAddress": "#{EMAIL_FROM}#",
    "FromName": "Arvion",
    "SalesInbox": "#{SALES_INBOX}#",
    "Host": "#{SMTP_HOST}#",
    "Port": 587,
    "Username": "#{SMTP_USERNAME}#",
    "Password": "#{SMTP_PASSWORD}#",
    "EnableSsl": true
  },
  "Captcha": {
    "Enabled": true,
    "Provider": "Turnstile",
    "SiteKey": "#{TURNSTILE_SITE_KEY}#",
    "SecretKey": "#{TURNSTILE_SECRET_KEY}#"
  }
}
